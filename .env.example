COMPOSE_PROJECT_NAME=ucaselab
POSTGRES_USER=ucaselab
POSTGRES_DB=ucaselab
# Generate unique values with: python3 scripts/init_env.py
ENVIRONMENT=production
PUBLIC_URL=https://qa.example.com
COOKIE_SECURE=true
ALLOWED_HOSTS=qa.example.com,api,localhost
HTTP_PORT=127.0.0.1:8080
TRUSTED_PROXY_CIDR=127.0.0.1
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=postgresql+psycopg://ucaselab:REPLACE_WITH_RANDOM_HEX@localhost:54329/ucaselab
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_URLSAFE_BASE64_32_BYTE_KEY
# Exact extra browser origins, comma separated; no wildcards.
ALLOWED_ORIGINS=
# Set false to register and sign in by password without sending email.
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=UCaseLab <noreply@example.com>
